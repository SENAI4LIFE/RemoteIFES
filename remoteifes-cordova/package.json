{
  "name": "remoteifes-cordova",
  "displayName": "RemoteIFES",
  "version": "1.0.0",
  "description": "Empacotamento Cordova (Android/iOS) do frontend RemoteIFES",
  "main": "index.js",
  "scripts": {
    "sync": "node sync-www.js",
    "validate": "node validate-config.js",
    "harden-config": "node harden-config.js",
    "android-version": "node android-version.js",
    "dev-config": "node harden-config.js --dev",
    "doctor": "node doctor.js",
    "inspect-apk": "node inspect-apk.js",
    "test-android": "node test-android.js",
    "test-ios": "node test-ios.js",
    "prepare-android": "node prepare-android.js",
    "prepare-ios": "node prepare-ios.js",
    "build-android": "npm run sync && cordova build android",
    "build-android-release": "node build-android-release.js",
    "publish-android-release": "node publish-android-release.js",
    "build-ios": "npm run sync && cordova build ios",
    "run-android": "npm run sync && cordova run android",
    "run-ios": "npm run sync && cordova run ios"
  },
  "cordova": {
    "plugins": {
      "cordova-plugin-statusbar": {}
    },
    "platforms": [
      "android",
      "ios"
    ]
  },
  "devDependencies": {
    "cordova": "^13.0.0",
    "cordova-android": "^15.1.0",
    "cordova-ios": "^8.1.1",
    "cordova-plugin-statusbar": "^4.0.0"
  }
}
