[Unit]
Description=RemoteIFES - Console de Operações
Documentation=file://__RAIZ_INSTALACAO__/DISTRIBUICAO.md
Requires=remoteifes-console.socket
After=remoteifes-console.socket

[Service]
Type=simple
User=__USUARIO__
WorkingDirectory=__RAIZ_INSTALACAO__
# A unidade aponta para a **camada estável**, nunca para uma versão. É o que permite que o
# console se atualize trocando o ponteiro em estado-instalacao.json sem reescrever esta unidade.
ExecStart=__NODE__ __RAIZ_INSTALACAO__/console-bootstrap.js
Environment=CONSOLE_ESTADO_DIR=__DIR_ESTADO__
Environment=CONSOLE_CHECKOUT_DIR=__CHECKOUT__
Environment=NODE_ENV=production
# O processo sai sozinho por ociosidade; o socket reabre o serviço na próxima conexão.
# success é a saída esperada, não um erro a ser reiniciado em laço.
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
# Parar ou reiniciar o console encerra só o processo principal. Cada operação longa roda sob um
# supervisor próprio (bin/supervisionar.js), que aplica o prazo máximo da operação, mantém a trava
# de manutenção e grava o desfecho; o console seguinte o adota ou lê esse desfecho. Com o padrão
# (control-group), uma queda ou atualização do console mataria uma restauração ou implantação no
# meio. Nenhum processo fica solto sem prazo: o supervisor encerra a operação ao fim do prazo.
KillMode=process

# Endurecimento compatível com o desenho de privilégio.
#
# NoNewPrivileges NÃO é usado aqui, ao contrário de remoteifes.service: o console precisa
# chamar `sudo` para o auxiliar root, e NoNewPrivileges=yes tornaria esse caminho inoperante.
# Endurecer o que não conflita, e ser explícito sobre o que não dá para endurecer, é mais
# honesto do que copiar um bloco de diretivas que quebraria a elevação.
PrivateTmp=yes
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Caminhos graváveis, explicitamente: estado do console, dados da aplicação (backup, trava,
# registro de deploy) e o checkout (deploy.sh troca o código e roda npm ci).
# __RAIZ_INSTALACAO__ é gravável para que a atualização instale versoes/<nova> e troque o ponteiro.
# O diretório de dados leva "-": ele só existe depois que o RemoteIFES roda pela primeira vez, e um
# caminho ausente sem "-" impede o serviço de subir (erro de namespace 226).
ReadWritePaths=__DIR_ESTADO__ -__DIR_DADOS__ __CHECKOUT__ __RAIZ_INSTALACAO__

[Install]
WantedBy=multi-user.target
