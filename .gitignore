# --- Node.js / remoteifes-server ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
.env
!.env.example

# --- SQLite database (generated at runtime) ---
remoteifes-server/data/*.db
remoteifes-server/data/*.db-shm
remoteifes-server/data/*.db-wal
remoteifes-server/data/*.db-journal
!remoteifes-server/data/.gitkeep

# --- Python scripts (clear.py / export.py / import.py) ---
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# --- Arduino / ESP32 (remoteifes-esp32) ---
build/
*.elf
*.bin
*.map
*.hex
.pio/
.pioenvs/
.piolibdeps/

# --- Editor / IDE ---
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo

# --- OS files ---
.DS_Store
Thumbs.db
Desktop.ini

# --- Logs ---
*.log
