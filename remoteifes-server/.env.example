NODE_ENV=development
PORTA=8080
CORS_ORIGIN=https://exemplo.com,https://outro-exemplo.com
# Opcional. Em produção, se omitida, uma senha aleatória será gerada e exibida no primeiro boot.
SENHA_ADMIN_INICIAL=
# Saltos de proxy reverso confiáveis ao ler X-Forwarded-For.
# Padrão 0 (nenhum). Use 1 apenas quando houver exatamente um proxy reverso
# confiável na frente (o https-setup.sh ajusta para 1 ao configurar o Nginx).
TRUST_PROXY=0

# Opcionais: dias de retenção do histórico antes da limpeza automática do banco.
# RETENCAO_DIAS_LOGS=180
# RETENCAO_DIAS_SESSOES=90
# RETENCAO_DIAS_EXECUCOES=90
# RETENCAO_DIAS_DETECCOES=30
