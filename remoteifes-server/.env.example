NODE_ENV=development
PORTA=8080
# Interface em que o servidor escuta. Padrão 0.0.0.0 (todas).
# Os scripts lan-setup.sh e https-setup.sh definem 127.0.0.1 para que o Node
# só seja acessível através do proxy reverso.
# BIND_ADDR=0.0.0.0
# Origens permitidas por CORS quando o frontend é servido de outra origem (ex.: GitHub Pages).
# Desnecessário na operação same-origin, em que o próprio servidor entrega o remoteifes-web.
CORS_ORIGIN=https://exemplo.com,https://outro-exemplo.com
# Servir o remoteifes-web pelo próprio servidor (operação same-origin).
# Padrão: ligado quando NODE_ENV=production, desligado nos demais casos.
# SERVIR_FRONTEND=true
# Caminho do frontend a servir (padrão: ../remoteifes-web relativo a este projeto).
# FRONTEND_DIR=../remoteifes-web
# Opcional na primeira criacao da conta. Se vazia, a conta inicial usa superadmin/admin e exibe um aviso persistente.
# SENHA_ADMIN_INICIAL=
# Duracao absoluta das sessoes em horas (padrao 12; intervalo aceito 1-168).
# SESSAO_MAX_HORAS=12
# Saltos de proxy reverso confiáveis ao ler X-Forwarded-For.
# Padrão 0 (nenhum). Use 1 apenas quando houver exatamente um proxy reverso
# confiável na frente (https-setup.sh e lan-setup.sh ajustam para 1 ao configurar o Nginx).
TRUST_PROXY=0

# Diretório de dados persistentes (banco, backups, firmware de OTA, versões e logs de deploy).
# Padrão: ./data neste projeto. Aponte para fora do checkout do git (ex.: /var/lib/remoteifes)
# para que atualizações de código nunca toquem nos dados.
# REMOTEIFES_DATA_DIR=/var/lib/remoteifes
# Pasta da imagem de firmware publicada para OTA do ESP32 (padrão: <REMOTEIFES_DATA_DIR>/firmware).
# REMOTEIFES_FIRMWARE_DIR=/var/lib/remoteifes/firmware

# Opcionais: dias de retenção do histórico antes da limpeza automática do banco.
# RETENCAO_DIAS_LOGS=180
# RETENCAO_DIAS_SESSOES=90
# RETENCAO_DIAS_EXECUCOES=90
# RETENCAO_DIAS_DETECCOES=30

# Backup automático do banco SQLite (snapshot consistente com o servidor no ar).
# BACKUP_AUTOMATICO: ligado por padrão quando NODE_ENV=production, desligado nos demais casos.
# BACKUP_AUTOMATICO=true
# BACKUP_INTERVALO_HORAS=24
# BACKUP_RETENCAO=14
# BACKUP_DIR=data/backups
